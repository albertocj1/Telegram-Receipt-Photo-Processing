    {
      "parameters": {
        "jsCode": "// Search returns 0 items when the folder doesn't exist yet.\n// Normalize to exactly 1 item so the IF node always has something to route,\n// instead of silently producing 0 items on both branches.\nconst items = $input.all();\n\nif (items.length === 0 || !items[0].json.id) {\n  return [{ json: { folderFound: false, id: null } }];\n}\n\nreturn [{ json: { folderFound: true, id: items[0].json.id } }];"
      },
