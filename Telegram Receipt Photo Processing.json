    {
      "parameters": {
        "jsCode": "const prev = $('Extract Photo Info').first().json;\nconst geminiJson = $input.first().json;\n// The Gemini analyze node consumes the binary for its API call but does not\n// forward it to its output, so pull the original photo binary directly from\n// the Download Photo node instead of from this node's own input.\nconst binary = $('Download Photo').first().binary;\n\nlet rawText = '';\ntry {\n  // n8n's Gemini node returns the candidate object directly\n  // (content.parts[0].text), not wrapped in a top-level \"candidates\" array\n  // like the raw Google API response would be. Check both shapes.\n  rawText = geminiJson.content?.parts?.[0]?.text\n    || geminiJson.candidates?.[0]?.content?.parts?.[0]?.text\n    || geminiJson.text\n    || JSON.stringify(geminiJson);\n} catch (e) {\n  rawText = JSON.stringify(geminiJson);\n}\n\nconst cleaned = rawText.replace(/```json|```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { merchant_name: null, total_amount: null, currency: null, transaction_date: null, category: null, parse_error: cleaned };\n}\n\nreturn [{\n  json: {\n    ...prev,\n    merchant_name: parsed.merchant_name,\n    total_amount: parsed.total_amount,\n    currency: parsed.currency,\n    transaction_date: parsed.transaction_date,\n    category: parsed.category\n  },\n  binary: binary\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        7424,
        1728
      ],
      "id": "ead3f0a2-b45d-4432-a528-6962942ee876",
      "name": "Parse Gemini Output"
    },
    {
      "parameters": {
        "resource": "image",
        "operation": "analyze",
        "modelId": {
          "__rl": true,
          "value": "models/gemini-3.7-flash",
          "mode": "list",
          "cachedResultName": "models/gemini-3.7-flash"
        },
        "text": "You are a receipt-processing assistant. Look at this receipt image and extract the following fields as strict JSON only, with no markdown formatting, code fences, or extra commentary:\n{\n  \"merchant_name\": string,\n  \"total_amount\": number,\n  \"currency\": string (ISO code if visible, else your best guess),\n  \"transaction_date\": string in YYYY-MM-DD format (use the date printed on the receipt, not today's date),\n  \"category\": string (one of: Groceries, Dining, Transportation, Utilities, Shopping, Health, Entertainment, Other)\n}\nIf a field cannot be determined, use null for that field. Return ONLY the JSON object, nothing else.",
        "inputType": "binary",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        7216,
        1728
      ],
      "id": "b29d61c0-aa15-4ef1-903b-24688645cac5",
      "name": "Analyze Receipt (Gemini)",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "credentials": {
        "googlePalmApi": {
          "id": "U2t5GMfT3x1mmmLF",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
