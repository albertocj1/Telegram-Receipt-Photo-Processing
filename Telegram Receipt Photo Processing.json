    {
      "parameters": {
        "jsCode": "const message = $input.first().json.message;\nconst photos = message.photo;\nconst largest = photos[photos.length - 1]; // Telegram returns sizes smallest-first\nconst submissionDate = new Date(message.date * 1000);\nconst folderDate = submissionDate.toISOString().split('T')[0]; // YYYY-MM-DD\n\nreturn [{\n  json: {\n    file_id: largest.file_id,\n    chat_id: message.chat.id,\n    from_username: message.from.username || message.from.first_name || 'unknown',\n    message_id: message.message_id,\n    submission_timestamp: message.date,\n    folder_date: folderDate\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
